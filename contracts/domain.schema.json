{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "分散赛区通勤保障决策台领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "SCHEDULE_FROZEN",
        "SCHEDULE_CHANGED",
        "REQUEST_ACCEPTED",
        "REQUEST_QUARANTINED",
        "RESOURCE_RESERVED",
        "RESOURCE_RELEASED",
        "JOURNEY_PLANNED",
        "JOURNEY_REPLANNED",
        "JOURNEY_LIFECYCLED",
        "SUPPLY_CHANGED",
        "COMMITMENT_CLOSED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "venue_schedule",
        "travel_request",
        "transport_resource",
        "journey_commitment"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "payload": {
      "type": "object"
    }
  },
  "payload_required_by_event": {
    "REQUEST_ACCEPTED": [
      "traveler_role",
      "required_arrival"
    ],
    "REQUEST_QUARANTINED": [
      "business_ref",
      "conflict_fields"
    ],
    "RESOURCE_RESERVED": [
      "resource_ref",
      "capacity"
    ],
    "RESOURCE_RELEASED": [
      "resource_ref",
      "reason"
    ],
    "JOURNEY_PLANNED": [
      "option_id",
      "mode",
      "reasons"
    ],
    "JOURNEY_REPLANNED": [
      "affected_segments",
      "reason"
    ],
    "JOURNEY_LIFECYCLED": [
      "node",
      "at_time"
    ],
    "SUPPLY_CHANGED": [
      "change_kind",
      "affected_refs",
      "effective_from"
    ],
    "COMMITMENT_CLOSED": [
      "outcome",
      "basis_event_ids"
    ]
  },
  "enums": {
    "lifecycle_node": [
      "CONFIRMED",
      "WAITING",
      "BOARDED",
      "NO_SHOW",
      "ESCALATED",
      "COMPLETED"
    ],
    "supply_change_kind": [
      "schedule_change",
      "transit_suspension",
      "road_restriction",
      "vehicle_offline",
      "security_window_closed"
    ],
    "close_outcome": [
      "completed",
      "cancelled",
      "superseded"
    ]
  },
  "additionalProperties": false
}
